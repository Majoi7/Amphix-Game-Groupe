# Backend Environment Variables
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Comma-separated list. In development, localhost and private-LAN origins are
# also accepted automatically so players can join from a phone on the same Wi-Fi.
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=your_session_secret_for_other_purposes

# Admin Authentication (REQUIRED for Phase 3B)
# Generate ADMIN_PASSWORD_HASH with: bcrypt.hash('your_admin_password', 10)
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here
# Generate JWT_SECRET with: crypto.randomBytes(32).toString('hex')
JWT_SECRET=your_secure_random_string_here
SECURE_COOKIES=false # Set to true in production with HTTPS (also switches cookies to SameSite=None)
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=2000 # Max requests per window for normal API traffic (players poll during a game)

# Player Authentication
# REQUIRED when NODE_ENV=production - the server refuses to start without it.
# In development it is optional: a separate value is derived from JWT_SECRET so
# local startup never blocks, and a warning is logged.
# Generate with: crypto.randomBytes(32).toString('hex')
PLAYER_JWT_SECRET=your_secure_random_string_here
PLAYER_SESSION_NAME=amphix_player_session